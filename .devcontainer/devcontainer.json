// Dev container for agentic development with beads (bd), git and Claude Code.
// See README.md in this folder for what this file does and the safety model.
{
  "name": "snagboat-dev",

  "build": { "dockerfile": "Dockerfile" },

  // Everything runs as this non-root user, which has no sudo.
  "remoteUser": "vscode",
  "containerUser": "vscode",

  // Extra hardening passed to `docker run`:
  //  - drop all Linux capabilities and block privilege escalation
  //  - send bd's usage-metrics hostname nowhere (belt and braces with the env vars below)
  "runArgs": [
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges",
    "--add-host=gastownhall-eventsapi.com=127.0.0.1",
    "--add-host=gastownhall-eventsapi.com=::1"
  ],

  // The project is mounted at the same path as on your Mac (not
  // /workspaces/<name>), so paths in Claude Code's transcripts name the same
  // folder on both sides and Snagboat on your Mac files them under this project.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",

  // Claude Code's login and settings live in a Docker volume, NOT your Mac's
  // ~/.claude. It survives container rebuilds; each project gets its own.
  // Only its transcripts (~/.claude/projects) are kept in the project folder
  // instead, in .snagboat/claude-projects/ (ignored by git), so Snagboat on your
  // Mac can read them once you run `snagboat containers allow` there. Nothing
  // Snagboat runs in the container. See README "Snagboat and this container".
  "mounts": [
    "source=claude-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=${localWorkspaceFolder}/.snagboat/claude-projects,target=/home/vscode/.claude/projects,type=bind"
  ],

  "containerEnv": {
    "BD_DISABLE_METRICS": "1",
    "DO_NOT_TRACK": "1",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },

  "remoteEnv": {
    // Don't hand your Mac's SSH keys (via the forwarded ssh-agent) to code in
    // the container. See README "Pushing to GitHub".
    "SSH_AUTH_SOCK": ""
  },

  // Runs once when the container is created.
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  // Runs every time the container starts: checks that nothing has set up git
  // hooks that would run on your Mac.
  "postStartCommand": "git config --global --get-all safe.directory 2>/dev/null | grep -qxF \"${containerWorkspaceFolder}\" || git config --global --add safe.directory \"${containerWorkspaceFolder}\"; bash .devcontainer/check-host-safety.sh; bash .devcontainer/carry-transcripts.sh start",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ]
    }
  },

  //Add language toolchains here, for example:
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    // GitHub CLI, for PRs. Needs its own login: see README "Pushing to GitHub".
    "ghcr.io/devcontainers/features/github-cli:1": {}
  }
}
