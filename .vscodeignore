# Everything is excluded by default; only the bundled extension and the
# docs vsce expects at the package root are shipped.
**
!dist/extension.js
# The CLI, which the extension also runs as the core service (snagboat serve).
!dist/snagboat.js
!media/**
# The Factory Clock package's page files, which the detail webview and the
# core's advisor UI load from packages/viz at runtime (the visualizers, the
# kit, the explorer, the theme, and their styles); its TypeScript is bundled
# into dist/ and its web page is not shipped.
!packages/viz/viz/**
!packages/viz/vizkit.js
!packages/viz/explore.js
!packages/viz/viz.css
!packages/viz/theme.css
!package.json
!README.md
!LICENSE
!PRIVACY.md
!THIRD_PARTY_LICENSES.md
!CHANGELOG.md
