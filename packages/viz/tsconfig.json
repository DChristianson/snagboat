{
  // The package's TypeScript: the visualizer catalog and the explorer's model
  // (src), and the web page's modules (src/web). The page touches the DOM, so
  // the DOM lib is on; nothing here may use Node (no node types), since the
  // web page bundles all of it for the browser.
  "compilerOptions": {
    "module": "node16",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "outDir": "out",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"]
}
