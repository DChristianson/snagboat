{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DChristianson/snagboat/schema/exported-event/v4",
  "title": "ExportedEvent",
  "description": "One line of an export's events/YYYY-MM-DD.jsonl (docs/design/export.md): a version 4 NormalizedEvent after the privacy rules, without workspace and raw (never exported), plus redactions, what the rules replaced in it. It matches the ExportedEvent type in exportRecords.ts; a unit test and a compile-time check keep them in step.",
  "type": "object",
  "required": [
    "eventId",
    "sessionId",
    "agent",
    "ts",
    "kind",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string"
    },
    "sessionId": {
      "type": "string"
    },
    "agent": {
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "claude-code",
            "copilot",
            "generic-fs"
          ]
        },
        {
          "pattern": "^custom:"
        }
      ]
    },
    "ts": {
      "type": "string",
      "description": "ISO 8601 timestamp."
    },
    "kind": {
      "enum": [
        "tool_call",
        "edit",
        "turn_start",
        "turn_stop",
        "user_prompt",
        "compaction",
        "session_name",
        "outcome"
      ]
    },
    "target": {
      "type": "string"
    },
    "status": {
      "enum": [
        "success",
        "failure",
        "unknown"
      ]
    },
    "model": {
      "type": "string"
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": {
          "type": "number"
        },
        "output": {
          "type": "number"
        },
        "cacheRead": {
          "type": "number"
        },
        "cacheCreation": {
          "type": "number"
        }
      }
    },
    "textExcerpt": {
      "type": "string"
    },
    "promptText": {
      "type": "string"
    },
    "sessionName": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    },
    "agentId": {
      "type": "string"
    },
    "toolName": {
      "type": "string"
    },
    "toolCategory": {
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "file-read",
            "file-edit",
            "search",
            "script",
            "tests-builds",
            "version-control",
            "shell",
            "web",
            "mcp",
            "subagent",
            "other"
          ]
        },
        {
          "pattern": "^[^:]*:shell/"
        }
      ]
    },
    "channel": {
      "const": "inline"
    },
    "endsTurn": {
      "const": true
    },
    "contextLimit": {
      "type": "number"
    },
    "todos": {
      "description": "tool_call events for the agent's todo tool: how many items are in each state, and their text when capture is on.",
      "type": "object",
      "required": [
        "pending",
        "inProgress",
        "completed"
      ],
      "additionalProperties": false,
      "properties": {
        "pending": {
          "type": "number"
        },
        "inProgress": {
          "type": "number"
        },
        "completed": {
          "type": "number"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "pending",
                  "in_progress",
                  "completed"
                ]
              }
            }
          }
        }
      }
    },
    "taskOp": {
      "description": "tool_call events for the agent's task tools: the change each made to its plan (a new task, a task's new status or subject, or the whole list), subjects only when capture is on.",
      "type": "object",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "create",
            "update",
            "list"
          ]
        },
        "id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "in_progress",
            "completed",
            "deleted"
          ]
        },
        "subject": {
          "type": "string"
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "pending",
                  "in_progress",
                  "completed"
                ]
              },
              "subject": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "compaction": {
      "type": "object",
      "required": [
        "trigger"
      ],
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "enum": [
            "auto",
            "manual",
            "unknown"
          ]
        },
        "preTokens": {
          "type": "number"
        },
        "postTokens": {
          "type": "number"
        }
      }
    },
    "outcome": {
      "description": "outcome events (version 3): what was measured.",
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "tests_green",
            "finding_response",
            "commit_kept",
            "commit_reverted",
            "code_survival",
            "milestone",
            "approval",
            "notified"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failures": {
          "type": "number"
        },
        "afterMs": {
          "type": "number"
        },
        "heuristicId": {
          "type": "string"
        },
        "response": {
          "enum": [
            "useful",
            "muted",
            "acknowledged",
            "passed"
          ]
        },
        "commit": {
          "type": "string"
        },
        "files": {
          "type": "number"
        },
        "linesWritten": {
          "type": "number"
        },
        "linesSurviving": {
          "type": "number"
        },
        "days": {
          "type": "number"
        },
        "advisor": {
          "type": "string"
        },
        "decision": {
          "enum": [
            "asked",
            "denied"
          ]
        }
      }
    },
    "toolInput": {
      "type": "object",
      "description": "tool_call events: the parts of the call's input worth drawing (a command, a path, a search pattern, a URL, the agent's description of the call). Never its output.",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "refs": {
      "type": "object",
      "description": "tool_call events: the commit, branch or plan items the call observably acted on (git commit, git checkout -b, bd close). Inferred relations are links, never refs.",
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string",
          "description": "A full or short SHA, as the command or its result showed it."
        },
        "branch": {
          "type": "string"
        },
        "planItems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "textTruncated": {
      "type": "boolean",
      "const": true,
      "description": "promptText or textExcerpt was cut at the store's cap."
    },
    "redactions": {
      "type": "array",
      "description": "What rules 1, 2 and 4 replaced in this event, by field and rule, without the values.",
      "items": {
        "type": "object",
        "required": [
          "field",
          "rule",
          "count"
        ],
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string",
            "description": "The field, as a dotted path: promptText, toolInput.command, todos.items."
          },
          "rule": {
            "type": "string",
            "description": "The rule that replaced it, as the manifest names it."
          },
          "count": {
            "type": "number",
            "description": "How many values it replaced there."
          }
        }
      }
    }
  }
}
