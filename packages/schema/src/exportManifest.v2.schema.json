{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DChristianson/snagboat/schema/export-manifest/v2",
  "title": "ExportManifest",
  "description": "An export folder's manifest.json (docs/design/export.md): its format and versions, project name, range, counts, how the privacy filter ran, and what each rule rewrote and kept. Version 2; version 1 had rulesVersion, redactions, flags and repository.privacy. It matches the ExportManifest type in exportRecords.ts; a unit test and a compile-time check keep them in step.",
  "type": "object",
  "required": [
    "format",
    "version",
    "eventSchema",
    "generatedAt",
    "project",
    "range",
    "text",
    "counts",
    "snagboatVersion",
    "filter",
    "rules",
    "readme",
    "schemas"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "type": "string",
      "const": "snagboat-export"
    },
    "version": {
      "type": "number",
      "const": 2,
      "description": "The export format's version."
    },
    "eventSchema": {
      "type": "number",
      "const": 4,
      "description": "The event schema version its events follow."
    },
    "generatedAt": {
      "type": "string"
    },
    "project": {
      "type": "string",
      "description": "The project name, from --name."
    },
    "range": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "since": {
          "type": "string"
        },
        "until": {
          "type": "string"
        },
        "first": {
          "type": "string",
          "description": "The first event exported."
        },
        "last": {
          "type": "string",
          "description": "The last event exported."
        }
      }
    },
    "text": {
      "enum": [
        "redacted",
        "none"
      ]
    },
    "counts": {
      "type": "object",
      "required": [
        "days",
        "events",
        "sessions",
        "findings",
        "commits",
        "branches",
        "checkouts",
        "planItems",
        "transitions",
        "links"
      ],
      "additionalProperties": false,
      "properties": {
        "days": {
          "type": "number"
        },
        "events": {
          "type": "number"
        },
        "sessions": {
          "type": "number"
        },
        "findings": {
          "type": "number"
        },
        "commits": {
          "type": "number"
        },
        "branches": {
          "type": "number"
        },
        "checkouts": {
          "type": "number"
        },
        "planItems": {
          "type": "number"
        },
        "transitions": {
          "type": "number"
        },
        "links": {
          "type": "number"
        }
      }
    },
    "snagboatVersion": {
      "type": "string"
    },
    "filter": {
      "enum": [
        "reviewed",
        "rewrite-all",
        "none"
      ],
      "description": "How the privacy filter ran: reviewed (every rule, each value decided by its rule's action or by you), rewrite-all (--rewrite-all) or none (--no-filter)."
    },
    "rules": {
      "type": "object",
      "description": "Distinct values each rule found, by rule id, and how many were rewritten and kept. Rules that found nothing are left out.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "rewritten",
          "kept"
        ],
        "additionalProperties": false,
        "properties": {
          "rewritten": {
            "type": "number"
          },
          "kept": {
            "type": "number"
          }
        }
      }
    },
    "readme": {
      "type": "string",
      "const": "README.md",
      "description": "The export's guide: what each file is, how they join, what the redaction markers mean."
    },
    "schemas": {
      "type": "object",
      "description": "Each file (a path, or a pattern like events/*.jsonl) and the JSON Schema in schema/ its records follow.",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
