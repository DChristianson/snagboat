{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DChristianson/snagboat/schema/proposal-event/v1",
  "title": "ProposalEvent",
  "description": "One line of an advisor's proposal log, ~/.snagboat/advisors/<id>/proposals.jsonl, append only (docs/design/goal-tracking-lifecycle.md). A proposed line carries the change, its scope, what it does, why, and a prediction; the other types record what you did with it. It matches the ProposalEvent type in advisorRecords.ts; a unit test and a compile-time check keep them in step.",
  "type": "object",
  "required": [
    "version",
    "at",
    "proposal",
    "advisor",
    "type"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "proposal": {
      "type": "string"
    },
    "advisor": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "discarded",
        "revised",
        "kept",
        "closed"
      ]
    },
    "report": {
      "type": "string"
    },
    "rev": {
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "change": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "key",
            "after"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "const": "setting"
            },
            "key": {
              "type": "string"
            },
            "before": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "after": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "rule"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "const": "rule"
            },
            "rule": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string"
                }
              }
            },
            "before": {
              "type": "object"
            }
          }
        }
      ]
    },
    "scope": {
      "anyOf": [
        {
          "type": "string",
          "const": "global"
        },
        {
          "type": "object",
          "required": [
            "workspace"
          ],
          "additionalProperties": false,
          "properties": {
            "workspace": {
              "type": "string"
            }
          }
        }
      ]
    },
    "what": {
      "type": "string"
    },
    "why": {
      "type": "string"
    },
    "prediction": {
      "type": "object",
      "required": [
        "measure",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "measure": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "target": {
          "type": "object",
          "required": [
            "direction",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "direction": {
              "type": "string",
              "enum": [
                "below",
                "above"
              ]
            },
            "value": {
              "type": "number"
            }
          }
        }
      }
    },
    "replaces": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  }
}
