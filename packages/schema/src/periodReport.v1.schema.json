{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DChristianson/snagboat/schema/period-report/v1",
  "title": "PeriodReport",
  "description": "An advisor's report for one stretch of time, ~/.snagboat/advisors/<id>/periods/<report id>.json (docs/design/goal-tracking-lifecycle.md). Its measures and rules are frozen when written; revisions hold what the advisor's model returned. It matches the PeriodReport type in advisorRecords.ts; a unit test and a compile-time check keep them in step.",
  "type": "object",
  "required": [
    "version",
    "id",
    "advisor",
    "advisorVersion",
    "period",
    "label",
    "from",
    "to",
    "trigger",
    "createdAt",
    "measures",
    "workspaces",
    "rules",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9A-Za-z-]+$"
    },
    "advisor": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "advisorVersion": {
      "type": "string"
    },
    "period": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly"
      ]
    },
    "label": {
      "type": "string"
    },
    "from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "to": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "trigger": {
      "type": "string",
      "enum": [
        "schedule",
        "request"
      ]
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "previous": {
      "type": "string"
    },
    "measures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "unit",
          "better"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "better": {
            "type": "string",
            "enum": [
              "lower",
              "higher"
            ]
          },
          "value": {
            "type": "number"
          },
          "previous": {
            "type": "number"
          },
          "trend": {
            "type": "string",
            "enum": [
              "better",
              "worse",
              "same"
            ]
          },
          "note": {
            "type": "string"
          },
          "series": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "workspace",
          "measures"
        ],
        "additionalProperties": false,
        "properties": {
          "workspace": {
            "type": "string"
          },
          "measures": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "unit",
                "better"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "better": {
                  "type": "string",
                  "enum": [
                    "lower",
                    "higher"
                  ]
                },
                "value": {
                  "type": "number"
                },
                "previous": {
                  "type": "number"
                },
                "trend": {
                  "type": "string",
                  "enum": [
                    "better",
                    "worse",
                    "same"
                  ]
                },
                "note": {
                  "type": "string"
                },
                "series": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "required": [
        "defaults",
        "projects",
        "saved"
      ],
      "additionalProperties": false,
      "properties": {
        "defaults": {
          "type": "object"
        },
        "projects": {
          "type": "object"
        },
        "saved": {
          "type": "array"
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rev",
          "createdAt",
          "summary",
          "verdicts",
          "proposals"
        ],
        "additionalProperties": false,
        "properties": {
          "rev": {
            "type": "number"
          },
          "createdAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
          },
          "model": {
            "type": "object",
            "required": [
              "advisor"
            ],
            "additionalProperties": false,
            "properties": {
              "advisor": {
                "type": "string"
              },
              "model": {
                "type": "string"
              }
            }
          },
          "summary": {
            "type": "string"
          },
          "verdicts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "experiment",
                "measure",
                "result",
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "experiment": {
                  "type": "string"
                },
                "measure": {
                  "type": "string"
                },
                "baseline": {
                  "type": "number"
                },
                "now": {
                  "type": "number"
                },
                "result": {
                  "type": "string",
                  "enum": [
                    "met",
                    "not-met",
                    "too-early",
                    "confounded"
                  ]
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "proposals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sent": {
            "type": "object",
            "required": [
              "at",
              "as"
            ],
            "additionalProperties": false,
            "properties": {
              "at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
              },
              "as": {
                "type": "string",
                "enum": [
                  "accept",
                  "revise"
                ]
              }
            }
          }
        }
      }
    }
  }
}
