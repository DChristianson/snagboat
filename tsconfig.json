{
  "compilerOptions": {
    "module": "node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node", "mocha"],
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"],
  // The web demo's page touches the DOM; tsconfig.web.json checks it (and src/web's pure modules are checked and tested here).
  "exclude": ["src/web/main.ts", "src/web/page.ts"]
}
